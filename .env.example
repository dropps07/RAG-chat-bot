# Copy this file to .env and fill in your own key. Never commit .env.
# Get a free key at https://aistudio.google.com/apikey

# Google Gemini API key (free tier)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model (free tier). gemini-3.5-flash-lite is the fast default; the
# full Flash model is slow. Change only if this model is not available for your key.
# Other free-tier options: gemini-2.5-flash, gemini-2.5-flash-lite, gemini-3.5-flash, gemini-3.8-flash
GEMINI_MODEL=gemini-3.5-flash-lite

# Local embedding model (downloads once, runs on your machine)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chunking and retrieval (defaults work well, change only if you know why)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=4
